--- !u!114 &636364294
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 636364292}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 66467c25029f1744db6e09d8d7ce38b4, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::TutorialWizardController
  wizardPanel: {fileID: 1517798133}
  spawnReference: {fileID: 934525206}
  distanceFromReference: 0.5
  localOffset: {x: 0, y: 0.02, z: 0}
  openOnStart: 1
  stepCounterText: {fileID: 618685743}
  titleText: {fileID: 1753269640}
  descriptionText: {fileID: 595689886}
  backButton: {fileID: 778911510}
  nextButton: {fileID: 127507058}
  nextButtonLabel: {fileID: 611656353}
  steps:
  - title: "\u0412\u0456\u0442\u0430\u0454\u043C\u043E \u0432 \u043B\u0430\u0431\u0456\u0440\u0438\u043D\u0442\u0456"
    description: "\u0414\u043E\u0441\u043B\u0456\u0434\u0438 \u0456\u0441\u0442\u043E\u0440\u0456\u044E \u0437\u0430\u0433\u0443\u0431\u043B\u0435\u043D\u043E\u0457 \u0432 \u0446\u044C\u043E\u043C\u0443 \u043C\u0456\u0441\u0446\u0456 \u0436\u0435\u0440\u0442\u0432\u0438. \u0426\u0435\u0439 \u043F\u043E\u043A\u0440\u043E\u043A\u043E\u0432\u0438\u0439 \u0433\u0456\u0434 \u0434\u043E\u043F\u043E\u043C\u043E\u0436\u0435 \u0440\u043E\u0437\u0456\u0431\u0440\u0430\u0442\u0438\u0441\u044F \u0437 \u043A\u0435\u0440\u0443\u0432\u0430\u043D\u043D\u044F\u043C."
  - title: "\u041B\u0456\u0445\u0442\u0430\u0440\u0438\u043A \u0456 \u0432\u0456\u043D'\u0454\u0442\u043A\u0430"
    description: "\u041D\u0430\u0442\u0438\u0441\u043D\u0438 Shift + N, \u0449\u043E\u0431 \u0432\u0456\u0434\u043A\u0440\u0438\u0442\u0438 \u043C\u0435\u043D\u044E \u043D\u0430\u043B\u0430\u0448\u0442\u0443\u0432\u0430\u043D\u044C: \u0432\u043C\u0438\u043A\u0430\u0439/\u0432\u0438\u043C\u0438\u043A\u0430\u0439 \u043B\u0456\u0445\u0442\u0430\u0440\u0438\u043A, \u0437\u043C\u0456\u043D\u044E\u0439 \u0439\u043E\u0433\u043E \u044F\u0441\u043A\u0440\u0430\u0432\u0456\u0441\u0442\u044C \u0442\u0430 \u0456\u043D\u0442\u0435\u043D\u0441\u0438\u0432\u043D\u0456\u0441\u0442\u044C \u0432\u0456\u043D'\u0454\u0442\u043A\u0438."
  - title: "\u0420\u0435\u0436\u0438\u043C\u0438 Ray/Poke \u0442\u0430 \u0437\u0430\u043C\u0456\u0442\u043A\u0438"
    description: "\u0423 \u043C\u0435\u043D\u044E \u043C\u043E\u0436\u043D\u0430 \u043F\u0435\u0440\u0435\u043C\u0438\u043A\u0430\u0442\u0438 \u0440\u0435\u0436\u0438\u043C\u0438 Ray \u0442\u0430 Poke, \u0447\u0438\u0442\u0430\u0442\u0438 \u0437\u0430\u043F\u0438\u0441\u043A\u0438 \u043D\u0430 \u0441\u0442\u0456\u043D\u0430\u0445 \u0456 \u0437\u0430\u043F\u0438\u0441\u0443\u0432\u0430\u0442\u0438 \u0432\u043B\u0430\u0441\u043D\u0456 \u043D\u043E\u0442\u0430\u0442\u043A\u0438 \u0434\u043E\u0441\u043B\u0456\u0434\u043D\u0438\u043A\u0430."
  - title: "\u0413\u043E\u0442\u043E\u0432\u043E \u0434\u043E \u0434\u043E\u0441\u043B\u0456\u0434\u0436\u0435\u043D\u043D\u044F"
    description: "\u0422\u0438 \u0433\u043E\u0442\u043E\u0432\u0438\u0439 \u043F\u0440\u043E\u0445\u043E\u0434\u0438\u0442\u0438 \u043B\u0430\u0431\u0456\u0440\u0438\u043D\u0442. \u041D\u0430\u0442\u0438\u0441\u043D\u0438 \xAB\u0417\u0430\u0432\u0435\u0440\u0448\u0438\u0442\u0438\xBB, \u0449\u043E\u0431 \u0437\u0430\u043A\u0440\u0438\u0442\u0438 \u0433\u0456\u0434. \u041F\u043E\u0432\u0435\u0440\u043D\u0443\u0442\u0438\u0441\u044F \u0434\u043E \u043D\u044C\u043E\u0433\u043E \u043C\u043E\u0436\u043D\u0430 \u043F\u043E Shift + T."
